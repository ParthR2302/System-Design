      "text": "Primary Goal: Satisfy\nNon-functional Requirements",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "n-SzCHT1LYBkSXo04Z-Zk",
      "originalText": "Primary Goal: Satisfy\nNon-functional Requirements",
