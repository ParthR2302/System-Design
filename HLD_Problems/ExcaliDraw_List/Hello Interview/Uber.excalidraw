      "updated": 1720777207705,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Pros:\nSimple representation as a single string, making it easy to store and share.\nEfficient for proximity searches, as nearby locations often share a prefix.\nUniform distribution of hash values.\n\nCons:\nPrecision varies across latitudes; higher latitudes have less precision.\nNot as efficient for bounding box searches due to its Z-order curve properties.\nBoundary issue: adjacent areas may not share the same prefix, complicating proximity searches.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pros:\nSimple representation as a single string, making it easy to store and share.\nEfficient for proximity searches, as nearby locations often share a prefix.\nUniform distribution of hash values.\n\nCons:\nPrecision varies across latitudes; higher latitudes have less precision.\nNot as efficient for bounding box searches due to its Z-order curve properties.\nBoundary issue: adjacent areas may not share the same prefix, complicating proximity searches.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
