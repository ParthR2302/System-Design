    {
      "type": "text",
      "id": "QqbMWOEQ-Z4LrhtymNZV3",
      "x": 3104.6296383797185,
      "y": 2704.1898593592377,
      "width": 910,
      "height": 140,
      "text": "Covering Index Example (posts table)\n\nRegular Index (user_id, created_at):\n(123, '2024-01-01') → Need to fetch likes from table!\n\nCovering Index (user_id, created_at) INCLUDE (likes):\n(123, '2024-01-01', likes: 42) → Everything needed is in the index! 🚀",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "version": 6,
      "versionNonce": 1874814978,
      "index": "b3e",
      "isDeleted": true,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1149864763,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1738798512312,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Covering Index Example (posts table)\n\nRegular Index (user_id, created_at):\n(123, '2024-01-01') → Need to fetch likes from table!\n\nCovering Index (user_id, created_at) INCLUDE (likes):\n(123, '2024-01-01', likes: 42) → Everything needed is in the index! 🚀",
      "autoResize": true,
      "lineHeight": 1.4285714285714286,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "id": "73nLmhbpFTGKXmHWfrGiG",
      "x": 3084.6296383797185,
      "y": 2884.1898593592377,
      "width": 950,
      "height": 100,
      "text": "💡 Partial Indexes: Only index rows you actually query (e.g., pending tasks)\n   → Smaller indexes, faster writes, better cache utilization\n\n🎯 Covering Indexes: Include extra columns to avoid table lookups\n   → Faster reads for specific queries, but larger index size",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "version": 8,
      "versionNonce": 2085392670,
      "index": "b3f",
      "isDeleted": true,
      "fillStyle": "solid",
      "strokeWidth": 2,
