    {
      "type": "text",
      "id": "OtAesrW7MvI-KdGT8vsvy",
      "x": 3385.421078142061,
      "y": 1869.7505685542521,
      "width": 565.5014736354351,
      "height": 80,
      "text": "- The composite index combines user_id and created_at into single key-pairs\n- Data is sorted by user_id first, then by created_at within each user_id\n- For user_id=123, we can quickly find and scan only relevant entries (highlighted)\n- Both filtering AND sorting are handled by a single index scan!",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "version": 17,
      "versionNonce": 921233730,
      "index": "b3U",
      "isDeleted": true,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1012178363,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1738798514913,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The composite index combines user_id and created_at into single key-pairs\n- Data is sorted by user_id first, then by created_at within each user_id\n- For user_id=123, we can quickly find and scan only relevant entries (highlighted)\n- Both filtering AND sorting are handled by a single index scan!",
      "autoResize": true,
      "lineHeight": 1.4285714285714286,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
