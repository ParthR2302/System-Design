      "link": null,
      "locked": false,
      "text": "SELECT \"videoId\", SUM(\"views\") as \"views\", \nFROM VideoViews \nWHERE \"timestamp\" >= {windowStart} AND \"timestamp\" <= {windowEnd}\nGROUP BY \"videoId\"\nORDER BY SUM(\"views\") DESC LIMIT {k};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT \"videoId\", SUM(\"views\") as \"views\", \nFROM VideoViews \nWHERE \"timestamp\" >= {windowStart} AND \"timestamp\" <= {windowEnd}\nGROUP BY \"videoId\"\nORDER BY SUM(\"views\") DESC LIMIT {k};",
