    {
      "id": "myh3uaBcO9L8eir6MuQP-",
      "type": "text",
      "x": 228.63020833333331,
      "y": 523.9973958333334,
      "width": 549.87109375,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1958163400,
      "version": 1232,
      "versionNonce": 432310968,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793630467538,
      "link": null,
      "locked": false,
      "text": "API\n\n// Create an auction\nPOST /auctions -> Auction\n{\n    item: Item,\n    startTime,\n    endTime,\n    startingPrice\n}\n\n// Bid on an auction\nPOST /auctions/:auctionId/bids -> Bid\n{\n    price\n}\n\n// View an auction\nGET /auctions/:auctionId -> Auction & Item & Bid[]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\n\n// Create an auction\nPOST /auctions -> Auction\n{\n    item: Item,\n    startTime,\n    endTime,\n    startingPrice\n}\n\n// Bid on an auction\nPOST /auctions/:auctionId/bids -> Bid\n{\n    price\n}\n\n// View an auction\nGET /auctions/:auctionId -> Auction & Item & Bid[]",
      "autoResize": false,
      "lineHeight": 1.25
    },
