      "seed": 699878693,
      "version": 185,
      "versionNonce": 443568363,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790529515471,
      "link": null,
      "locked": false,
      "text": "Notes:\n\n- WebSocket connections and real-time\nmessaging demonstrate the broader real-\ntime updates pattern used across many\ndistributed systems. Whether it's chat\nmessages, live dashboards, collaborative\nediting, or gaming, the same principles\napply: persistent connections for low\nlatency, pub/sub for scaling across\nservers, and careful state management\nfor reliability.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notes:\n\n- WebSocket connections and real-time messaging demonstrate the broader real-time updates pattern used across many distributed systems. Whether it's chat messages, live dashboards, collaborative editing, or gaming, the same principles apply: persistent connections for low latency, pub/sub for scaling across servers, and careful state management for reliability.",
      "autoResize": false,
      "lineHeight": 1.25
    },
