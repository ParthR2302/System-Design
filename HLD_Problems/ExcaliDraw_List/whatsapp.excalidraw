      "groupIds": [
        "rJVdxY3rInwHLKqtfh_Rc"
      ],
      "frameId": null,
      "index": "a36",
      "roundness": null,
      "seed": 644766379,
      "version": 167,
      "versionNonce": 1191414635,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790492616881,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- Start Chat (Can be grp, individual or any)\n- send/receive messages\n- send/receive media\n- load messages (especially coming back online after\nbeing offline)\n\nNon-Functional\n- Low Latency (<500ms)\n- Guarantee the delivery of messages\n- Billions of users -> High throughput\n- Fault Tolerant\n- Messages not stored unnecessarily",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "pW6btvtGMgIhQjya8Xyft",
      "originalText": "Functional Requirements\n- Start Chat (Can be grp, individual or any)\n- send/receive messages\n- send/receive media\n- load messages (especially coming back online after being offline)\n\nNon-Functional\n- Low Latency (<500ms)\n- Guarantee the delivery of messages\n- Billions of users -> High throughput\n- Fault Tolerant\n- Messages not stored unnecessarily",
      "autoResize": true,
      "lineHeight": 1.25
    },
