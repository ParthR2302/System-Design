    {
      "id": "P6VkjSWVVGDWPNQnONx5D",
      "type": "text",
      "x": 1649.0905567956352,
      "y": -284.5734747023812,
      "width": 526.142578125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "gajc4oVK3IJPEcT84_omp"
      ],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1068234531,
      "version": 447,
      "versionNonce": 1172038253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793131907456,
      "link": null,
      "locked": false,
      "text": "There can be an issue of Race Condition if multiple\ninstrances of Gateway services try to access same\ndata\n- We need to ensure atomicity in Redis read HMGET\nand update HSET for a single instance of Gateway\n- We can do this using Lua Scripting",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There can be an issue of Race Condition if multiple instrances of Gateway services try to access same data\n- We need to ensure atomicity in Redis read HMGET and update HSET for a single instance of Gateway\n- We can do this using Lua Scripting",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "LsFzkbAiL0WdK_-dGn-6A",
      "type": "text",
      "x": 1648.9017547123015,
      "y": -463.8052455357145,
      "width": 465.3125000000002,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "gajc4oVK3IJPEcT84_omp"
      ],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1809110051,
      "version": 279,
      "versionNonce": 1181682893,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793131907456,
      "link": null,
      "locked": false,
      "text": "Rate Limiter Algorithms\n- Fixed Window Counter\n- Sliding Window Log\n- Sliding Window Counter\n- Token Bucket (We generally use this)\n- Leaky Bucket",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rate Limiter Algorithms\n- Fixed Window Counter\n- Sliding Window Log\n- Sliding Window Counter\n- Token Bucket (We generally use this)\n- Leaky Bucket",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ukM4AgjS9xjYxCBz4NIPh",
      "type": "text",
      "x": 1641.5970672123015,
      "y": -55.88206845238108,
      "width": 757.1158854166657,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 2127248291,
      "version": 73,
      "versionNonce": 1424627373,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793132259529,
      "link": null,
      "locked": false,
      "text": "X-RateLimit-Limit: The Rate Limit ceiling for that request (e.g. 100)\nX-RateLimit-Remaining: Number of requests left in the current window (e.g. 0)\nX-RateLimit-Reset: When the rate-limit resets, as a Unix timestamp\nRetry-After: 60",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "X-RateLimit-Limit: The Rate Limit ceiling for that request (e.g. 100)\nX-RateLimit-Remaining: Number of requests left in the current window (e.g. 0)\nX-RateLimit-Reset: When the rate-limit resets, as a Unix timestamp\nRetry-After: 60",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
